              "bsonType": "object",
              "required": [
                "nombre_archivo",
                "tipo_mime",
                "peso_kb",
                "url_storage",
                "fecha_carga"
              ],
              "additionalProperties": false,
              "properties": {
                "nombre_archivo": {
                  "bsonType": "string"
                },
                "tipo_mime": {
                  "enum": [
