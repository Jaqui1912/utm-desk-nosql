                  "bsonType": "date"
                },
                "tecnico": {
                  "bsonType": "string"
                },
                "estado": {
                  "enum": [
                    "abierta",
                    "en proceso",
                    "en espera",
                    "resuelta",
                    "cerrada"
                  ]
                },
                "horas": {
                  "bsonType": [
                    "double",
                    "int"
                  ],
                  "minimum": 0
                },
                "comentario": {
                  "bsonType": "string"
                }
              }
            }
          },
          "evidencias_adjuntas": {
            "bsonType": "array",
