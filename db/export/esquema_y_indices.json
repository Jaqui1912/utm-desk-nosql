            "minimum": 0
          },
          "tags": {
            "bsonType": "array",
            "uniqueItems": true,
            "items": {
              "bsonType": "string"
            }
          },
          "detalle_especifico": {
            "bsonType": "object"
          },
          "historial_seguimiento": {
            "bsonType": "array",
            "items": {
              "bsonType": "object",
              "required": [
                "fecha",
                "tecnico",
                "estado",
                "horas",
                "comentario"
              ],
              "additionalProperties": false,
              "properties": {
