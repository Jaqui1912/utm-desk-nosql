[
  {
    "coleccion": "usuarios",
    "validador": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "nombre",
          "correo",
          "password_hash",
          "rol",
          "activo",
          "fecha_alta"
        ],
        "additionalProperties": false,
        "properties": {
          "_id": {
            "bsonType": "objectId"
          },
          "nombre": {
            "bsonType": "string",
            "minLength": 3
          },
          "correo": {
            "bsonType": "string",
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
          },
          "password_hash": {
            "bsonType": "string",
            "minLength": 20
          },
          "rol": {
            "enum": [
              "reportante",
              "admin_general",
              "tecnico",
              "directivo",
              "admin_sistema"
            ]
          },
          "tipo": {
            "enum": [
              "docente",
              "estudiante",
              "administrativo"
            ]
          },
          "especialidades": {
            "bsonType": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "computo_redes",
                "infraestructura",
                "academico"
              ]
            }
          },
          "activo": {
            "bsonType": "bool"
          },
          "fecha_alta": {
            "bsonType": "date"
          }
        },
        "oneOf": [
          {
            "properties": {
              "rol": {
                "enum": [
                  "reportante"
                ]
              }
            },
            "required": [
              "tipo"
            ]
          },
          {
            "properties": {
              "rol": {
                "enum": [
                  "admin_general",
                  "tecnico",
                  "directivo",
                  "admin_sistema"
                ]
              }
            }
          }
        ]
      }
    },
    "nivel_de_validacion": "strict",
    "accion_de_validacion": "error",
    "indices": [
      {
        "key": {
          "_id": 1
        },
        "name": "_id_"
      },
      {
        "key": {
          "correo": 1
        },
        "name": "uniq_correo",
        "unique": true
      }
    ]
  },
  {
    "coleccion": "incidencias_campus",
    "validador": {
